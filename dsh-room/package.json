{
  "name": "dsh-room",
  "version": "0.1.0",
  "description": "大肥鱼的房间：可布置的 2.5D 等距小屋，桌宠和同伴住进来会自己过日子，跟着 DSH 工作状态忙前忙后。",
  "icon": "assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "room",
    "isometric",
    "web-ui"
  ],
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*": "./locales/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "web",
    "assets",
    "locales",
    "scripts/preview.mjs",
    "scripts/launch.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/preview.mjs",
    "town": "node scripts/town.mjs",
    "preview": "node scripts/launch.mjs",
    "desktop": "node scripts/launch.mjs --desktop",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-alpha.2": "unknown"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
