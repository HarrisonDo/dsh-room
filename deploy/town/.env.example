# 复制成 .env 再填。.env 已被 .gitignore 忽略，不要提交。

# 域名（先把 DNS 的 A 记录指到服务器 IP）
TOWN_DOMAIN=town.example.com
TOWN_PUBLIC_URL=https://town.example.com

# 站长：github:你的登录名 或 linuxdo:用户名，多个用逗号分隔
TOWN_OWNER=github:your-login

# GitHub OAuth App（回调：https://域名/auth/github/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# linux.do Connect（回调：https://域名/auth/linuxdo/callback）
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
# 最低信任等级，0 = 不限
LINUXDO_MIN_TRUST=1

# 外部屏蔽词服务（可选；接口见 docs/08 第 3.1 节）
MODERATION_URL=
MODERATION_TOKEN=
# 外部服务出错时：review = 送人工审核（默认），local = 只用本地词表
MODERATION_ON_ERROR=review

# 额外允许跨域访问的网页来源（可选，逗号分隔）。DSH、本机预览、桌面版已默认允许
TOWN_ORIGINS=
