# 域名来自 .env 的 TOWN_DOMAIN；Caddy 自动申请和续期 HTTPS 证书。
{$TOWN_DOMAIN} {
	encode gzip
	# 旧小镇和世界场次的 SSE（/events、/world-events）均立即转发
	reverse_proxy town:18780 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
